# Copy this file to .env and set your own values; .env is not committed.
# docker compose reads .env automatically; the API reads it too when started outside Docker (dotnet run / Visual Studio).

# Password of the postgres user. It is applied when the database volume is first created; to change it later run
#   docker exec chat-postgres psql -U postgres -c "ALTER USER postgres PASSWORD '<new password>'"
# (or remove the volume with `docker compose down -v`, which deletes all data).
# If this is left unset, compose falls back to "postgres": fine for a throwaway local database only
# (it is published on 127.0.0.1 only), never for anything shared.
POSTGRES_PASSWORD=change-me-postgres-password

# Secret used to sign login tokens, at least 32 characters, for example the output of: openssl rand -base64 48
# If this is left unset the API generates a random key at startup: everything works, but all users are
# signed out whenever the API restarts.
JWT_SIGNING_KEY=change-me-to-a-long-random-string-of-at-least-32-characters

# Shared secret between the Jabber server (ejabberd) and the API: the Jabber server asks the API to check logins.
# If unset, a fixed demo value is used, which is fine locally but should be changed anywhere else.
XMPP_AUTH_SECRET=change-me-shared-secret-between-jabber-server-and-api

# The website user with this username can open the administration pages (Jabber dashboard). Whoever registers
# this username first gets that access, so choose a name nobody else will take before you do.
ADMIN_USERNAME=admin
